# ------------------------------------------------------------------
# Hapination Live — variáveis de ambiente.
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA compartilhe o arquivo .env nem publique tokens.
# ------------------------------------------------------------------

# Token do bot (obrigatório). Crie em https://discord.com/developers/applications
DISCORD_BOT_TOKEN=COLE_SEU_TOKEN_AQUI

# Nome alternativo aceito (mesmo token). Descomente se preferir usar este nome.
# DISCORD_TOKEN=COLE_SEU_TOKEN_AQUI

# ID do Discord do proprietário (obrigatório). É o único que pode alterar
# créditos, suspender/reativar usuários e gerenciar administradores.
OWNER_DISCORD_ID=000000000000000000

# Tamanho máximo de upload de vídeo em MB (opcional, padrão 25).
MAX_UPLOAD_MB=25
